  @@index([BenutzerID], map: "idx_restaurantbestellungen_benutzerid")
  @@index([RechnungsID], map: "idx_restaurantbestellungen_rechnungsid")
  @@index([Status], map: "idx_restaurantbestellungen_status")
  @@index([Bestelldatum], map: "idx_restaurantbestellungen_datum")
}

model RestaurantBestellpositionen {
  PositionID              Int                                  @id @default(autoincrement())
  RestaurantBestellID     Int
  ProduktID               Int
  Menge                   Decimal                              @db.Decimal(10, 2)
  EinzelpreisNetto        Decimal                              @db.Decimal(10, 2)
  GesamtpreisNetto        Decimal                              @db.Decimal(10, 2)
  MwStSatz                Decimal                              @db.Decimal(5, 2)
  MwStBetrag              Decimal                              @db.Decimal(10, 2)
  Status                  RestaurantBestellpositionen_Status?  @default(Bestellt)
  Notizen                 String?                              @db.Text
  KuecheNotizen           String?                              @db.Text
  BestelltUm              DateTime?                            @default(dbgenerated("(now())")) @db.Timestamp(0)
  ZubereitetUm            DateTime?                            @db.Timestamp(0)
  ServiertUm              DateTime?                            @db.Timestamp(0)
  Erstelldatum            DateTime?                            @default(dbgenerated("(now())")) @db.Timestamp(0)
  LetzteAenderung         DateTime?                            @default(now()) @db.Timestamp(0)

  RestaurantBestellungen RestaurantBestellungen @relation(fields: [RestaurantBestellID], references: [RestaurantBestellID], onDelete: Cascade, onUpdate: NoAction, map: "RestaurantBestellpositionen_ibfk_1")
  Produkte               Produkte               @relation(fields: [ProduktID], references: [ProduktID], onDelete: NoAction, onUpdate: NoAction, map: "RestaurantBestellpositionen_ibfk_2")

  @@index([RestaurantBestellID], map: "idx_restaurantbestellpositionen_bestellid")
  @@index([ProduktID], map: "idx_restaurantbestellpositionen_produktid")
  @@index([Status], map: "idx_restaurantbestellpositionen_status")
}

enum RestaurantTische_Status {
  Verfuegbar
  Besetzt
  Reserviert
  Gesperrt
}

enum Reservierungen_Status {
  Bestaetigt
  Eingecheckt
  Abgeschlossen
  Storniert
  Nicht_Erschienen @map("Nicht Erschienen")
}

enum RestaurantBestellungen_Status {
  Offen
  In_Bearbeitung @map("In Bearbeitung")
  Serviert
  Abgeschlossen
  Storniert
}

enum RestaurantBestellpositionen_Status {
  Bestellt
  In_Zubereitung @map("In Zubereitung")
  Bereit
  Serviert
  Storniert
}

enum RestaurantBestellungen_Zahlungsart {
  Bar
  Kreditkarte
  EC_Karte @map("EC-Karte")
  Rechnung
  Gutschein
}
