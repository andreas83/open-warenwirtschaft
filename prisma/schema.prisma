enum HotelBuchungen_Zahlungsstatus {
  Ausstehend
  Angezahlt
  Bezahlt
  Teilbezahlt
  Rueckerstattet @map("Rückerstattet")
  Storniert
}

enum HotelZusatzleistungen_Typ {
  Fruehstueck @map("Frühstück")
  Roomservice
