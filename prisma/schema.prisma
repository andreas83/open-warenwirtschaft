  ShopKategorien                ShopKategorien?         @relation(fields: [ShopKategorieID], references: [ShopKategorieID], onDelete: NoAction, onUpdate: NoAction, map: "ShopProdukte_ibfk_2")
  ShopBestellpositionen         ShopBestellpositionen[]
  ShopWarenkorbpositionen       ShopWarenkorbpositionen[]
  ShopBewertungen               ShopBewertungen[]

  @@index([ProduktID], map: "idx_shopprodukte_produktid")
  @@index([ShopKategorieID], map: "idx_shopprodukte_kategorieid")
  @@index([Slug], map: "idx_shopprodukte_slug")
  @@index([IstAktiv], map: "idx_shopprodukte_aktiv")
}

// Shopping Cart
model ShopWarenkorb {
  WarenkorbID                   Int                       @id @default(autoincrement())
  KundenID                      Int?
  SessionID                     String?                   @db.VarChar(255)
  Status                        ShopWarenkorb_Status?     @default(Aktiv)
  Erstelldatum                  DateTime?                 @default(dbgenerated("(now())")) @db.Timestamp(0)
  LetzteAenderung               DateTime?                 @default(now()) @db.Timestamp(0)

  Kunden                        Kunden?                   @relation(fields: [KundenID], references: [KundenID], onDelete: Cascade, onUpdate: NoAction, map: "ShopWarenkorb_ibfk_1")
  ShopWarenkorbpositionen       ShopWarenkorbpositionen[]

  @@index([KundenID], map: "idx_shopwarenkorb_kundenid")
  @@index([SessionID], map: "idx_shopwarenkorb_sessionid")
}

// Shopping Cart Items
model ShopWarenkorbpositionen {
  WarenkorbpositionsID          Int                @id @default(autoincrement())
  WarenkorbID                   Int
  ShopProduktID                 Int
  Menge                         Int                @default(1)
  Preis                         Decimal            @db.Decimal(10, 2)
  AttributeJSON                 String?            @db.Text
  Erstelldatum                  DateTime?          @default(dbgenerated("(now())")) @db.Timestamp(0)
  LetzteAenderung               DateTime?          @default(now()) @db.Timestamp(0)

  ShopWarenkorb                 ShopWarenkorb      @relation(fields: [WarenkorbID], references: [WarenkorbID], onDelete: Cascade, onUpdate: NoAction, map: "ShopWarenkorbpositionen_ibfk_1")
  ShopProdukte                  ShopProdukte       @relation(fields: [ShopProduktID], references: [ShopProduktID], onDelete: NoAction, onUpdate: NoAction, map: "ShopWarenkorbpositionen_ibfk_2")

  @@index([WarenkorbID], map: "idx_shopwarenkorbpositionen_warenkorbid")
  @@index([ShopProduktID], map: "idx_shopwarenkorbpositionen_produktid")
}

// Shop Orders
model ShopBestellungen {
  ShopBestellID                 Int                         @id @default(autoincrement())
  KundenID                      Int
  Bestellnummer                 String                      @unique(map: "ShopBestellnummer") @db.VarChar(50)
  Bestelldatum                  DateTime?                   @default(dbgenerated("(now())")) @db.Timestamp(0)
  Status                        ShopBestellungen_Status?    @default(Neu)
  Zahlungsstatus                ShopBestellungen_Zahlungsstatus? @default(Ausstehend)
  Versandstatus                 ShopBestellungen_Versandstatus?  @default(NichtVersendet)
  Zahlungsart                   ShopBestellungen_Zahlungsart?
  Versandart                    String?                     @db.VarChar(100)

  // Customer Information
  RechnungsVorname              String                      @db.VarChar(100)
  RechnungsNachname             String                      @db.VarChar(100)
  RechnungsFirma                String?                     @db.VarChar(255)
  RechnungsAdresse              String                      @db.VarChar(255)
  RechnungsPLZ                  String                      @db.VarChar(10)
  RechnungsOrt                  String                      @db.VarChar(100)
  RechnungsLand                 String                      @db.VarChar(100)
  RechnungsTelefon              String?                     @db.VarChar(50)
  RechnungsEmail                String                      @db.VarChar(255)

  LieferungVorname              String                      @db.VarChar(100)
  LieferungNachname             String                      @db.VarChar(100)
  LieferungFirma                String?                     @db.VarChar(255)
  LieferungAdresse              String                      @db.VarChar(255)
  LieferungPLZ                  String                      @db.VarChar(10)
  LieferungOrt                  String                      @db.VarChar(100)
  LieferungLand                 String                      @db.VarChar(100)
  LieferungTelefon              String?                     @db.VarChar(50)

  // Pricing
  ZwischensummeNetto            Decimal                     @db.Decimal(10, 2)
  Versandkosten                 Decimal?                    @default(0.00) @db.Decimal(10, 2)
  RabattBetrag                  Decimal?                    @default(0.00) @db.Decimal(10, 2)
  RabattCode                    String?                     @db.VarChar(50)
  MwStGesamt                    Decimal                     @db.Decimal(10, 2)
  GesamtsummeBrutto             Decimal                     @db.Decimal(10, 2)
  Waehrung                      String?                     @default("EUR") @db.VarChar(3)

  // Additional Information
  KundenNotizen                 String?                     @db.Text
  InterneNotizen                String?                     @db.Text
  IPAdresse                     String?                     @db.VarChar(45)
  UserAgent                     String?                     @db.VarChar(255)

  // Tracking
  TrackingNummer                String?                     @db.VarChar(100)
  VersandDatum                  DateTime?                   @db.Timestamp(0)
  ZugesteltDatum                DateTime?                   @db.Timestamp(0)

  Erstelldatum                  DateTime?                   @default(dbgenerated("(now())")) @db.Timestamp(0)
  LetzteAenderung               DateTime?                   @default(now()) @db.Timestamp(0)

  Kunden                        Kunden                      @relation(fields: [KundenID], references: [KundenID], onDelete: NoAction, onUpdate: NoAction, map: "ShopBestellungen_ibfk_1")
  ShopBestellpositionen         ShopBestellpositionen[]
  ShopZahlungen                 ShopZahlungen[]

  @@index([KundenID], map: "idx_shopbestellungen_kundenid")
  @@index([Bestelldatum], map: "idx_shopbestellungen_bestelldatum")
  @@index([Status], map: "idx_shopbestellungen_status")
  @@index([Zahlungsstatus], map: "idx_shopbestellungen_zahlungsstatus")
}

// Shop Order Items
model ShopBestellpositionen {
  ShopBestellpositionsID        Int                 @id @default(autoincrement())
  ShopBestellID                 Int
  ShopProduktID                 Int
  Produktname                   String              @db.VarChar(255)
  SKU                           String?             @db.VarChar(100)
  Menge                         Int
  EinzelpreisNetto              Decimal             @db.Decimal(10, 2)
  GesamtpreisNetto              Decimal             @db.Decimal(10, 2)
  MwStSatz                      Decimal             @db.Decimal(5, 2)
  MwStBetrag                    Decimal             @db.Decimal(10, 2)
  AttributeJSON                 String?             @db.Text
  Erstelldatum                  DateTime?           @default(dbgenerated("(now())")) @db.Timestamp(0)

  ShopBestellungen              ShopBestellungen    @relation(fields: [ShopBestellID], references: [ShopBestellID], onDelete: Cascade, onUpdate: NoAction, map: "ShopBestellpositionen_ibfk_1")
  ShopProdukte                  ShopProdukte        @relation(fields: [ShopProduktID], references: [ShopProduktID], onDelete: NoAction, onUpdate: NoAction, map: "ShopBestellpositionen_ibfk_2")

  @@index([ShopBestellID], map: "idx_shopbestellpositionen_bestellid")
  @@index([ShopProduktID], map: "idx_shopbestellpositionen_produktid")
}

// Shop Payments
model ShopZahlungen {
  ShopZahlungID                 Int                          @id @default(autoincrement())
  ShopBestellID                 Int
  Betrag                        Decimal                      @db.Decimal(10, 2)
  Waehrung                      String?                      @default("EUR") @db.VarChar(3)
  Zahlungsart                   ShopZahlungen_Zahlungsart
  TransaktionsID                String?                      @db.VarChar(255)
  Status                        ShopZahlungen_Status?        @default(Ausstehend)
  ZahlungsdatumErhalten         DateTime?                    @db.Timestamp(0)
  PaymentProviderAntwort        String?                      @db.Text
  Kommentare                    String?                      @db.Text
  Erstelldatum                  DateTime?                    @default(dbgenerated("(now())")) @db.Timestamp(0)

  ShopBestellungen              ShopBestellungen             @relation(fields: [ShopBestellID], references: [ShopBestellID], onDelete: Cascade, onUpdate: NoAction, map: "ShopZahlungen_ibfk_1")

  @@index([ShopBestellID], map: "idx_shopzahlungen_bestellid")
  @@index([TransaktionsID], map: "idx_shopzahlungen_transaktionid")
}

// Product Reviews
model ShopBewertungen {
  BewertungID                   Int                     @id @default(autoincrement())
  ShopProduktID                 Int
  KundenID                      Int?
  Bewertername                  String                  @db.VarChar(255)
  Email                         String?                 @db.VarChar(255)
  Bewertung                     Int
  Titel                         String?                 @db.VarChar(255)
  Kommentar                     String?                 @db.Text
  Status                        ShopBewertungen_Status? @default(Ausstehend)
  IstVerifizierterKauf          Boolean?                @default(false)
  Erstelldatum                  DateTime?               @default(dbgenerated("(now())")) @db.Timestamp(0)
  LetzteAenderung               DateTime?               @default(now()) @db.Timestamp(0)

  ShopProdukte                  ShopProdukte            @relation(fields: [ShopProduktID], references: [ShopProduktID], onDelete: Cascade, onUpdate: NoAction, map: "ShopBewertungen_ibfk_1")
  Kunden                        Kunden?                 @relation(fields: [KundenID], references: [KundenID], onDelete: NoAction, onUpdate: NoAction, map: "ShopBewertungen_ibfk_2")

  @@index([ShopProduktID], map: "idx_shopbewertungen_produktid")
  @@index([KundenID], map: "idx_shopbewertungen_kundenid")
  @@index([Status], map: "idx_shopbewertungen_status")
}

// Shop Settings
model ShopEinstellungen {
  EinstellungID                 Int       @id @default(autoincrement())
  SchluesselName                String    @unique(map: "ShopEinstellungSchluessel") @db.VarChar(100)
  Wert                          String?   @db.Text
  Typ                           String?   @db.VarChar(50)
  Beschreibung                  String?   @db.Text
  Kategorie                     String?   @db.VarChar(100)
  Erstelldatum                  DateTime? @default(dbgenerated("(now())")) @db.Timestamp(0)
  LetzteAenderung               DateTime? @default(now()) @db.Timestamp(0)

  @@index([Kategorie], map: "idx_shopeinstellungen_kategorie")
}

